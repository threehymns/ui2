// Open in UI2 Studio, enable the Layout inspector and try Phone/Tablet/Desktop.
Screen {
    id: AdaptiveForm
    width: 760
    height: 520
    adaptive: true
    layout_breakpoint_width: 600
    layout_breakpoint_height: 600
    background: #F8FAFC

    Label { id: title x: 24 y: 24 width: 712 height: 32 text: "Adaptive contact form" font_size: 24 color: #172033 layout_x: stretch }
    Label { id: intro x: 24 y: 72 width: 712 height: 24 text: "One form, different window sizes." color: #64748B layout_x: stretch }
    TextField { id: name x: 24 y: 120 width: 712 height: 36 placeholder: "Name" background: #FFFFFF layout_x: stretch }
    TextField { id: email x: 24 y: 168 width: 712 height: 36 placeholder: "Email" background: #FFFFFF layout_x: stretch }
    TextArea { id: message x: 24 y: 224 width: 712 height: 212 text: "Message" background: #FFFFFF layout_x: stretch layout_y: stretch layout_min_height: 40 }
    Button {
        id: submit
        x: 624 y: 460 width: 112 height: 36
        text: "Send"
        background: #2563EB color: #FFFFFF
        on_tap: send_message
        layout_x: end layout_y: end
        LayoutVariation {
            width_class: compact height_class: any
            reference_width: 390 reference_height: 844
            x: 24 y: 784 width: 342 height: 36
            layout_x: stretch layout_y: end
        }
    }
    Button {
        id: help
        x: 24 y: 460 width: 112 height: 36
        text: "Help"
        background: #FFFFFF color: #172033
        on_tap: show_help
        layout_y: end
        LayoutVariation {
            width_class: compact height_class: any
            reference_width: 390 reference_height: 844
            x: 24 y: 784 width: 112 height: 36
            layout_x: start layout_y: end
            hidden: true
        }
    }
}
